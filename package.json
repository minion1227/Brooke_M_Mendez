    "@types/node": "^26.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  }
}
