---
import { profile, socials } from '../data/profile';
import { resumeHref } from '../lib/assets';
import Section from './Section.astro';
import Icon from './Icon.astro';
---

<Section
  id="contact"
  title="Get in touch"
  lede="Open to new opportunities and always happy to talk. The fastest way to reach me is email."
>
  {/* Email and phone are peers — same weight, same size, each with its own
      icon so the pair scans as a contact block rather than a headline. */}
  <ul class="space-y-3">
    <li>
      <a
        href={`mailto:${profile.email}`}
        class="link-sweep group inline-flex items-center gap-3 text-base font-medium break-all transition-colors hover:text-[var(--accent)]"
      >
        <Icon
          name="mail"
          class="h-[18px] w-[18px] shrink-0 text-[var(--text-muted)] transition-colors group-hover:text-[var(--accent)]"
        />
        {profile.email}
      </a>
    </li>

    {
      profile.phone && (
        <li>
          <a
            href={`tel:${profile.phone.replace(/[^+\d]/g, '')}`}
            class="link-sweep group inline-flex items-center gap-3 text-base font-medium transition-colors hover:text-[var(--accent)]"
          >
            <Icon
              name="phone"
              class="h-[18px] w-[18px] shrink-0 text-[var(--text-muted)] transition-colors group-hover:text-[var(--accent)]"
            />
            {profile.phone}
          </a>
        </li>
      )
    }

    {/* Not a link — where you are is context for the two contact methods above,
        not a third way to reach you. Same row rhythm, no hover affordance. */}
    <li class="flex items-center gap-3 text-base font-medium text-[var(--text-muted)]">
      <Icon name="pin" class="h-[18px] w-[18px] shrink-0" />
      {profile.location}
    </li>
  </ul>

  <div class="mt-10 flex flex-wrap gap-3">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith('mailto:') ? undefined : '_blank'}
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-sm transition-colors hover:bg-[var(--surface-raised)]"
        >
          <Icon name={social.icon} class="h-4 w-4" />
          {social.label}
        </a>
      ))
    }

    {
      resumeHref && (
        <a
          href={resumeHref}
          download
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-sm transition-colors hover:bg-[var(--surface-raised)]"
        >
          <Icon name="download" class="h-4 w-4" />
          Download resume
        </a>
      )
    }
  </div>
</Section>
