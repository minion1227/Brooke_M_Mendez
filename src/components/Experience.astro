---
import { experience } from '../data/profile';
import Section from './Section.astro';
import Icon from './Icon.astro';
---

<Section id="experience" title="Experience">
  <ol class="relative space-y-12 border-l border-[var(--border)] pl-6 sm:pl-8">
    {
      experience.map((job) => {
        const isBreak = job.variant === 'break';
        return (
          <li class="relative">
            {/* Timeline node, centered on the rail. Breaks get a hollow node. */}
            <span
              aria-hidden="true"
              class:list={[
                'absolute top-2 -left-[calc(1.5rem+4.5px)] h-[9px] w-[9px] rounded-full ring-4 ring-[var(--surface)] sm:-left-[calc(2rem+4.5px)]',
                isBreak
                  ? 'border border-[var(--text-muted)] bg-[var(--surface)]'
                  : 'bg-[var(--accent)]',
              ]}
            />

            <p class="font-mono text-xs tracking-wide text-[var(--text-muted)]">
              {job.start} — {job.end}
              {job.type && <span> · {job.type}</span>}
            </p>

            {isBreak ? (
              <>
                <h3 class="mt-2 text-base font-medium text-[var(--text-muted)]">
                  {job.role}
                </h3>
                {job.summary && (
                  <p class="measure mt-2 text-[15px] leading-relaxed text-[var(--text-muted)] xl:text-base">
                    {job.summary}
                  </p>
                )}
              </>
            ) : (
              <>
                <h3 class="display mt-2 text-2xl">{job.role}</h3>

                <p class="mt-0.5 text-sm text-[var(--text-muted)]">
                  {job.href ? (
                    <a
                      href={job.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-0.5 transition-colors hover:text-[var(--accent)]"
                    >
                      {job.company}
                      <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  ) : (
                    job.company
                  )}
                  {job.location && <span> · {job.location}</span>}
                </p>

                {job.project && (
                  <p class="mt-3 text-sm">
                    <span class="font-mono text-xs tracking-wide text-[var(--text-muted)]">
                      Project ·{' '}
                    </span>
                    {job.project.href ? (
                      <a
                        href={job.project.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-0.5 font-medium text-[var(--accent)] transition-opacity hover:opacity-75"
                      >
                        {job.project.name}
                        <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                      </a>
                    ) : (
                      <span class="font-medium">{job.project.name}</span>
                    )}
                  </p>
                )}

                {job.summary && (
                  <p class="measure mt-4 text-[15px] leading-relaxed text-[var(--text-muted)] xl:text-base">
                    {job.summary}
                  </p>
                )}

                {job.highlights && job.highlights.length > 0 && (
                  <ul class="measure mt-4 space-y-2">
                    {job.highlights.map((item) => (
                      <li class="relative pl-5 text-[15px] leading-relaxed text-[var(--text-muted)] xl:text-base">
                        <span
                          aria-hidden="true"
                          class="absolute top-[0.65em] left-0 h-1 w-1 rounded-full bg-[var(--text-muted)]"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}

                {job.tech && job.tech.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-1.5">
                    {job.tech.map((tag) => (
                      <li class="rounded-full border border-[var(--border)] px-2.5 py-1 font-mono text-[11px] text-[var(--text-muted)]">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</Section>
